#!/usr/bin/env python3
"""CLI entry point: system/run <data folder> <output file>"""

from __future__ import annotations

import json
import os
import sys
import time


def main() -> int:
    if len(sys.argv) != 3:
        sys.stderr.write("Usage: system/run <data folder> <output file>\n")
        return 2

    system_dir = os.path.dirname(os.path.abspath(__file__))
    if system_dir not in sys.path:
        sys.path.insert(0, system_dir)

    from engine import solve_dataset
    from llm_client import LLMClient

    data_dir = os.path.abspath(sys.argv[1])
    output_file = os.path.abspath(sys.argv[2])

    t0 = time.time()
    llm = LLMClient()
    rows = solve_dataset(data_dir, llm_client=llm)

    out_parent = os.path.dirname(output_file)
    if out_parent:
        os.makedirs(out_parent, exist_ok=True)
    with open(output_file, "w", encoding="utf-8") as handle:
        for row in rows:
            handle.write(json.dumps(row, ensure_ascii=False) + "\n")

    elapsed = time.time() - t0
    sys.stderr.write(
        f"Processed {len(rows)} hits in {elapsed:.2f}s "
        f"(llm_provider={llm.provider}, model={llm.default_model or 'none'}, stats={llm.stats})\n"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
