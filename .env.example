# Copy this file to .env for local testing (never commit .env or real API keys).
# Load locally with: set -a && source .env && set +a

# === Submission / Production (OpenRouter — used by judges) ===
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_PROVIDER=Google

# === Optional Local Testing Only (xAI Grok) ===
# Used ONLY when OPENROUTER_API_KEY is empty. Leave OPENROUTER_API_KEY blank to test with Grok.
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning
